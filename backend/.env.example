# Server Configuration
PORT=5000
NODE_ENV=development
# Set to 1 when running behind one proxy/load balancer (Render, Nginx, ...)
TRUST_PROXY=

# Database
MONGODB_URI=mongodb://localhost:27017/whatsapp-automation
# Or use MongoDB Atlas:
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/whatsapp-automation

# JWT Secret
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRE=7d

# Email Configuration (for notifications)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password

# Razorpay (Payment Gateway)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Meta (WhatsApp, Instagram, Facebook)
# App secret from Meta App Dashboard -> App settings -> Basic. Used to verify
# the X-Hub-Signature-256 header on every webhook; webhooks are rejected
# without it. Set META_WEBHOOK_SKIP_SIGNATURE=true only for local curl tests.
META_APP_SECRET=your_meta_app_secret
META_WEBHOOK_SKIP_SIGNATURE=false
# Graph API version used for all three platforms
META_GRAPH_API_URL=https://graph.facebook.com/v23.0
# Tokens you type into the Meta dashboard when subscribing the webhook URLs
WHATSAPP_VERIFY_TOKEN=choose_a_random_string
INSTAGRAM_VERIFY_TOKEN=choose_a_random_string
FACEBOOK_VERIFY_TOKEN=choose_a_random_string
# Public URL of this server (e.g. an ngrok URL). Needed so WhatsApp can
# download attachments sent from the inbox.
PUBLIC_BASE_URL=

# Instagram Graph API
INSTAGRAM_ACCESS_TOKEN=your_instagram_access_token
INSTAGRAM_BUSINESS_ACCOUNT_ID=your_instagram_business_id

# Cloudinary (for image uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Admin Credentials (default admin user)
ADMIN_EMAIL=admin@chatshopai.com
ADMIN_PASSWORD=Admin@12345
# Same email, second password: opens the limited Admin panel
ADMIN_PANEL_PASSWORD=Admin@123456
