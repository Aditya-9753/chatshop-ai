# Server Configuration
PORT=5000
NODE_ENV=development
# Set to 1 when running behind one proxy/load balancer (Render, Nginx, ...)
TRUST_PROXY=

# Database
MONGODB_URI=mongodb://localhost:27017/whatsapp-automation
# Or use MongoDB Atlas:
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/whatsapp-automation

# JWT Secret
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRE=7d

# Email Configuration (for notifications)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password

# Razorpay (shops paying ChatShop for their plan)
# Keys look like rzp_test_… / rzp_live_…. Without real keys (and outside
# production) a test gateway is used: shops press "Simulate success/failure".
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Razorpay dashboard → Webhooks: URL https://<server>/api/webhooks/razorpay,
# events payment.captured, payment.failed, order.paid, refund.processed,
# refund.failed, and this same secret
RAZORPAY_WEBHOOK_SECRET=choose_a_random_string
# Force a gateway: razorpay | mock (mock is refused in production)
PAYMENT_GATEWAY=

# ChatShop AI website assistant (the help chat on the landing page).
# Which AI answers: claude | gemini | off. Unset: the first one with a key.
# Without a key (or if the AI fails) it uses built-in answers.
ASSISTANT_PROVIDER=
# Claude: https://platform.claude.com → API keys
ANTHROPIC_API_KEY=
# Gemini (free tier for testing): https://aistudio.google.com → Get API key.
# Free-tier prompts may be used by Google; never send customer data here.
GEMINI_API_KEY=
# Models tried in order when one is busy (comma separated)
GEMINI_MODEL=gemini-flash-lite-latest,gemini-3-flash-preview,gemini-flash-latest
# off = always use built-in answers, even with a key
ASSISTANT_AI=
# Messages per visitor per minute
ASSISTANT_RATE_LIMIT=15

# Meta (WhatsApp, Instagram, Facebook)
# App secret from Meta App Dashboard -> App settings -> Basic. Used to verify
# the X-Hub-Signature-256 header on every webhook; webhooks are rejected
# without it. Set META_WEBHOOK_SKIP_SIGNATURE=true only for local curl tests.

META_APP_SECRET=your_meta_app_secret
META_WEBHOOK_SKIP_SIGNATURE=false

# Graph API version used for all three platforms

META_GRAPH_API_URL=https://graph.facebook.com/v23.0

# Tokens you type into the Meta dashboard when subscribing the webhook URLs

WHATSAPP_VERIFY_TOKEN=choose_a_random_string
INSTAGRAM_VERIFY_TOKEN=choose_a_random_string
FACEBOOK_VERIFY_TOKEN=choose_a_random_string

# Public URL of this server (e.g. an ngrok URL). Needed so WhatsApp can
# download attachments sent from the inbox.

PUBLIC_BASE_URL=

# Instagram Graph API
INSTAGRAM_ACCESS_TOKEN=your_instagram_access_token
INSTAGRAM_BUSINESS_ACCOUNT_ID=your_instagram_business_id

# Cloudinary (for image uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Admin Credentials (default admin user)
ADMIN_EMAIL=admin@chatshopai.com
ADMIN_PASSWORD=Admin@12345

# Same email, second password: opens the limited Admin panel
ADMIN_PANEL_PASSWORD=Admin@123456
